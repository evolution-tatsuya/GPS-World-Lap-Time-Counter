# ===== 必須 =====

# データベース接続文字列（Neon など PostgreSQL）
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# セッション署名鍵。本番では必ず強いランダム値に変更すること（32文字以上推奨）。
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 本番(NODE_ENV=production)でこれが未設定 or デフォルトのままだとサーバーは起動を拒否する。
SESSION_SECRET="your-secret-key-here-minimum-32-characters"

# ===== サーバー =====

# 待受ポート。Cloud Run は起動時に PORT を注入する（通常8080）ので、本番では明示不要。
PORT=8432

# development / production。本番では production にする（secure Cookie・trust proxy・fail-fastが有効化）。
NODE_ENV=development

# ===== 任意 =====

# CORS許可オリジン。
# 【同一オリジン統合構成（推奨）】フロントを同じサーバーから配信するので未設定でよい（CORS不要）。
# 【フロント別ドメイン構成】フロントのURLを指定するとそのオリジンからのCookie付きAPIを許可する。
# FRONTEND_URL="https://your-frontend.example.com"

# ビルド済みフロント(dist)の配置パス。未設定なら ../frontend/dist を自動探索。
# Dockerイメージ内では /app/backend/frontend-dist に固定している（Dockerfile参照）。
# FRONTEND_DIST_PATH="/app/backend/frontend-dist"

# ===== EC連携（サブスク販売・/api/integration） =====
# EC(ショッピングページ)からのサブスク連携を受ける共有シークレット。
# EC側の env GPS_API_KEY と「同一値」を設定する（在庫管理用の値とは別の新規発行値・使い回さない）。
# 未設定の間は /api/integration/* は 503 を返し全拒否（フェイルクローズ）。
# 値はパスワードマネージャー「GPS-EC-Integration-Key」に保管。チャット等に平文で貼らない。
# GPS_INTEGRATION_API_KEY=""
