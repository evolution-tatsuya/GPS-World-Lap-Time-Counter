// GPS World Lap Time Counter - Database Schema
// Version: 2.2 (Multi-Sport Support)
// Date: 2026-07-08

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ========== ユーザー管理 ==========

model User {
  id           String   @id @default(uuid())
  email        String?  @unique
  passwordHash String?  @map("password_hash")
  name         String
  role         UserRole @default(DRIVER)
  // プロモ枠: 課金免除の特別運営アカウント（オーナーのPR/営業デモ用）。
  // このユーザーが作るイベントは課金判定をバイパスする。
  isPromo      Boolean  @default(false) @map("is_promo")
  // 車載カメラ(ライブ映像)機能の利用可否。統括(ADMIN)が運営アカウントごとに切替。
  // 既定は無効。有効な運営が作るイベントでのみ車載映像機能が使える。
  cameraEnabled Boolean @default(false) @map("camera_enabled")
  // サブスク課金の状態（決済連携前はADMINが手動で設定。将来Stripe Webhookで更新）。
  subscriptionPlan   SubscriptionPlan   @default(NONE)   @map("subscription_plan")
  subscriptionStatus SubscriptionStatus @default(INACTIVE) @map("subscription_status")
  subscriptionUntil  DateTime?          @map("subscription_until") // 有効期限（nullは無期限/未設定）
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // リレーション
  courses Course[]
  events  Event[]
  laps    Lap[]

  @@map("users")
}

enum UserRole {
  DRIVER     // 一般参加者
  ORGANIZER  // イベント運営者
  ADMIN      // システム管理者
}

enum SubscriptionPlan {
  NONE       // 未加入
  PERSONAL   // 個人利用プラン
  ORGANIZER  // 運営者プラン
}

enum SubscriptionStatus {
  INACTIVE   // 無効（未加入/解約）
  ACTIVE     // 有効
  EXPIRED    // 期限切れ
}

// ========== コース管理（マルチスポーツ対応） ==========

model Course {
  id                 String      @id @default(uuid())
  country            String      // 国 (例: "Japan", "USA")
  state              String?     // 都道府県/州 (例: "Mie", "California")
  name               String      // コース名 (例: "Suzuka Circuit", "Tokyo Marathon Course")
  courseType         CourseType  @default(CLOSED_CIRCUIT) @map("course_type")
  sportCategories    Json        @map("sport_categories") // ['car', 'motorcycle', 'bicycle', 'running', ...]
  controlLineALat    Decimal     @map("control_line_a_lat") @db.Decimal(10, 7)
  controlLineALng    Decimal     @map("control_line_a_lng") @db.Decimal(10, 7)
  controlLineBLat    Decimal     @map("control_line_b_lat") @db.Decimal(10, 7)
  controlLineBLng    Decimal     @map("control_line_b_lng") @db.Decimal(10, 7)
  // 計測タイプ: LAP=周回(1本のライン)、ONE_WAY=片道(スタート/ゴール別ライン)
  measureType        MeasureType @default(LAP) @map("measure_type")
  // 片道モードのゴールライン（ONE_WAYのとき使用。nullable）
  goalLineALat       Decimal?    @map("goal_line_a_lat") @db.Decimal(10, 7)
  goalLineALng       Decimal?    @map("goal_line_a_lng") @db.Decimal(10, 7)
  goalLineBLat       Decimal?    @map("goal_line_b_lat") @db.Decimal(10, 7)
  goalLineBLng       Decimal?    @map("goal_line_b_lng") @db.Decimal(10, 7)
  referenceTime      Int?        @map("reference_time") // 秒単位
  courseLength       Decimal?    @map("course_length") @db.Decimal(5, 2) // km
  elevationGain      Int?        @map("elevation_gain") // m（高低差）
  description        String?     @db.Text
  isPublic           Boolean     @default(true) @map("is_public")
  // 承認ステータス: 運営が登録したコースはPENDING、統括(ADMIN)が承認するとAPPROVED。
  // イベントで使えるのはAPPROVEDのみ。既存コースは移行時にAPPROVED扱い（default）。
  approvalStatus     ApprovalStatus @default(APPROVED) @map("approval_status")
  createdBy          String?     @map("created_by")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  // リレーション
  creator User?   @relation(fields: [createdBy], references: [id])
  events  Event[]
  laps    Lap[]   // 個人計測ラップ（courseId経由）

  @@unique([country, state, name]) // 重複防止
  @@index([country, state]) // 検索高速化
  @@map("courses")
}

enum CourseType {
  CLOSED_CIRCUIT // クローズドサーキット（専用コース）
  PUBLIC_ROAD    // 一般道・公道
  FARM_ROAD      // 農道・林道
  TRAIL          // トレイル・山道
  WATER          // 水上（海・湖・川）
  OTHER          // その他
}

enum MeasureType {
  LAP      // 周回計測（1本のコントロールライン）
  ONE_WAY  // 片道計測（スタートライン→ゴールラインの区間）
}

enum ApprovalStatus {
  PENDING   // 申請中（運営が登録、統括の承認待ち）
  APPROVED  // 承認済み（統括が検証。イベントで使える）
  REJECTED  // 却下
}

// ========== イベント管理（マルチスポーツ対応） ==========

model Event {
  id              String        @id @default(uuid())
  name            String        // イベント名
  courseId        String        @map("course_id")
  sportCategory   SportCategory @map("sport_category") // イベント対象スポーツカテゴリ
  eventDate       DateTime      @map("event_date") @db.Date
  // 開催時間帯。位置共有はこの時間内のみ許可される（時間外は送受信を遮断）。
  // 未設定の場合は eventDate 当日を開催日として扱う（後方互換）。
  startAt         DateTime?     @map("start_at")
  endAt           DateTime?     @map("end_at")
  eventCode       String        @unique @map("event_code") // 6桁コード (例: ABC123)
  maxParticipants Int?          @map("max_participants")
  isPublic        Boolean       @default(true) @map("is_public")
  // プロモ枠のイベント（課金免除・最大100台まで無料）。
  // プロモアカウントが作成、または作成時に指定される。
  isPromo         Boolean       @default(false) @map("is_promo")
  organizerId     String        @map("organizer_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  // リレーション
  course    Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  organizer User   @relation(fields: [organizerId], references: [id])
  laps      Lap[]

  @@index([eventCode])
  @@index([eventDate])
  @@index([courseId])
  @@index([sportCategory]) // スポーツカテゴリでの検索高速化
  @@map("events")
}

enum SportCategory {
  CAR                // 車（四輪）
  MOTORCYCLE         // バイク（二輪）
  KART               // カート
  BICYCLE_ROAD       // ロードバイク
  BICYCLE_MTB        // MTB
  BICYCLE_CYCLOCROSS // シクロクロス
  RUNNING            // ランニング
  RUNNING_MARATHON   // マラソン
  RUNNING_TRAIL      // トレイルランニング
  SKIING             // スキー
  SNOWBOARDING       // スノーボード
  BOAT               // ボート
  CANOE              // カヌー
  OTHER              // その他
}

// ========== ラップ記録（マルチスポーツ対応） ==========

model Lap {
  id              String        @id @default(uuid())
  // イベント計測ではeventId必須。個人計測(イベントなし)ではnull。
  eventId         String?       @map("event_id")
  // 個人計測でどのコースを走ったか（イベント計測ではeventから辿れるので任意）。
  courseId        String?       @map("course_id")
  userId          String?       @map("user_id") // ログインユーザーの場合
  participantName String        @map("participant_name") // ドライバー/ランナー/ライダー等
  sportCategory   SportCategory @map("sport_category") // スポーツカテゴリ
  vehicleOrGear   String?       @map("vehicle_or_gear") // 車両/装備情報（車両名、自転車、シューズ等）
  lapNumber       Int           @map("lap_number")
  lapTimeMs       Int           @map("lap_time_ms") // ミリ秒
  lapTimeStr      String        @map("lap_time_str") // 表示用 (例: "1:23.456")
  // セッション管理（計測スタート毎に発行。同日の複数走行を区別）
  sessionId       String?       @map("session_id")
  sessionName     String?       @map("session_name") // 任意のセッション名（例: 午前フリー走行）
  // 追加入力項目（単体HTML版と同等）
  zekken          String?       @map("zekken") // ゼッケン番号
  klass           String?       @map("klass") // クラス・カテゴリ
  tire            String?       @map("tire") // タイヤ・天候メモ
  note            String?       @map("note") // 自由メモ
  recordedAt      DateTime      @default(now()) @map("recorded_at")

  // リレーション
  event  Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id])

  @@index([eventId, lapTimeMs]) // ランキング高速化
  @@index([userId])
  @@index([userId, courseId]) // 個人のコース別ベスト
  @@index([sportCategory]) // スポーツカテゴリでの検索高速化
  @@index([recordedAt])
  @@index([eventId, sessionId]) // セッション別集計
  @@map("laps")
}
